{
  "name": "@kampfire/bulkify",
  "version": "1.9.0",
  "description": "For handling bulk operations in Shopify",
  "main": "dist/index.js",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kampfire-dev/bulkify.git"
  },
  "homepage": "https://github.com/kampfire-dev/bulkify",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "script": "tsx ./src/tests/script.ts",
    "example:nested": "tsx ./src/examples/nested-objects.ts",
    "deploy": "pnpm build && npm publish",
    "typecheck": "tsc --noEmit"
  },
  "author": "Matt Oskamp",
  "license": "ISC",
  "devDependencies": {
    "@shopify/admin-api-client": "^1.1.1",
    "@shopify/shopify-api": "^14.0.0",
    "@types/node": "^22.19.0",
    "dotenv": "^16.6.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.3",
    "ora": "^8.2.0"
  },
  "types": "./dist/index.d.ts",
  "keywords": [
    "shopify",
    "bulk",
    "operations"
  ],
  "engines": {
    "node": ">=20"
  }
}
