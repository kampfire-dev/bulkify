{
  "name": "@kampfire/bulkify",
  "version": "2.1.0",
  "description": "For handling bulk operations in Shopify",
  "main": "dist/index.js",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kampfire-dev/bulkify.git"
  },
  "homepage": "https://github.com/kampfire-dev/bulkify",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc -w",
    "test": "vitest run --project unit",
    "example:nested": "tsx ./src/examples/nested-results.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "npm:publish": "npm publish",
    "codegen": "graphql-codegen --config codegen.ts",
    "test:store": "vitest run --project store",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "example:prices": "tsx ./src/examples/update-prices.ts"
  },
  "author": "Matt Oskamp",
  "license": "ISC",
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@shopify/admin-api-client": "^1.1.1",
    "@shopify/shopify-api": "^14.0.0",
    "@types/node": "^22.19.0",
    "dotenv": "^16.6.1",
    "graphql": "^16.14.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "ora": "^8.2.0"
  },
  "types": "./dist/index.d.ts",
  "keywords": [
    "shopify",
    "bulk",
    "operations"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1"
}
